<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/public-head', { title: 'Contact Us', description: 'Contact Akanksha Grammar High School: address, phone numbers, email addresses, office hours and map.' }) %>
</head>
<body class="site">
  <%- include('../partials/public-navbar') %>

  <main id="main">
    <%- include('../partials/page-hero', {
      heroPhoto: 'library-rows',
      heroCrumbs: [{ href: '/', label: 'Home' }, { label: 'Contact' }],
      heroTitle: 'Get in touch',
      heroText: 'Questions about admissions, academics or a campus visit? We’d love to hear from you.'
    }) %>

    <section class="section">
      <div class="container contact-grid">
        <div data-reveal>
          <h2 class="display display-m">Send us<br>a message</h2>
          <p class="lede">We usually reply within one working day.</p>

          <% if (typeof success !== 'undefined' && success.length > 0) { %>
            <div class="alert alert-success" role="status"><%- icon('circle-check') %><span><%= success %></span></div>
          <% } %>

          <form action="/portfolio/contact" method="POST" class="form">
            <div class="form-row">
              <div class="field">
                <label for="name">Full name <span class="req">*</span></label>
                <input type="text" id="name" name="name" required autocomplete="name" placeholder="Your name">
              </div>
              <div class="field">
                <label for="email">Email <span class="req">*</span></label>
                <input type="email" id="email" name="email" required autocomplete="email" placeholder="you@example.com">
              </div>
            </div>
            <div class="form-row">
              <div class="field">
                <label for="phone">Phone <span class="req">*</span></label>
                <input type="tel" id="phone" name="phone" required autocomplete="tel" placeholder="+91 98765 43210">
              </div>
              <div class="field">
                <label for="subject">Subject <span class="req">*</span></label>
                <select id="subject" name="subject" required>
                  <option value="">Select a subject</option>
                  <option value="admission">Admission inquiry</option>
                  <option value="academic">Academic information</option>
                  <option value="visit">Campus visit</option>
                  <option value="general">General query</option>
                  <option value="feedback">Feedback</option>
                  <option value="other">Other</option>
                </select>
              </div>
            </div>
            <div class="field">
              <label for="message">Message <span class="req">*</span></label>
              <textarea id="message" name="message" rows="4" required placeholder="How can we help?"></textarea>
            </div>
            <div class="pills"><button type="submit" class="pill pill--light">Send Message <%- icon('arrow-right') %></button></div>
          </form>
        </div>

        <div class="info-blocks" data-reveal>
          <div class="info-block">
            <span class="label">Address</span>
            <p>Ganesh Enclave, Mallapur<br>Hyderabad, Telangana 500005<br>India</p>
            <p><a href="https://www.google.com/maps/place/Akanksha+grammar+school/@17.2937018,78.4980856,17z/data=!4m6!3m5!1s0x3bcba34f1a56bb5f:0xf90f548152bda15f!8m2!3d17.2937018!4d78.4980856!16s%2Fg%2F11jg8g9f66" target="_blank" rel="noopener">Open in Google Maps</a></p>
          </div>
          <div class="info-block">
            <span class="label">Phone</span>
            <p>School office <a href="tel:+919912697521">+91 99126 97521</a></p>
          </div>
          <div class="info-block">
            <span class="label">Email</span>
            <p><a href="mailto:info@akankshaschool.edu">info@akankshaschool.edu</a><br><a href="mailto:admissions@akankshaschool.edu">admissions@akankshaschool.edu</a><br><a href="mailto:principal@akankshaschool.edu">principal@akankshaschool.edu</a></p>
          </div>
          <div class="info-block">
            <span class="label">Office hours</span>
            <p>Monday – Friday, 8:00 AM – 5:00 PM<br>Saturday, 9:00 AM – 2:00 PM<br><span class="muted">Closed on Sundays</span></p>
          </div>
        </div>
      </div>
    </section>

    <section class="section section--tight">
      <div class="container">
        <div class="rows-head" data-reveal>
          <h2 class="display display-m">Find us</h2>
          <span class="count muted">Mallapur, Hyderabad</span>
        </div>
        <div class="map-frame" data-reveal="fade">
          <iframe
            title="Map showing the school's location"
            src="https://www.google.com/maps/embed?origin=mfe&amp;pb=!1m3!2m1!1s17.2937018,78.4980856!6i17!3m1!1sen!5m1!1sen"
            allowfullscreen
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"></iframe>
        </div>
      </div>
    </section>
  </main>

  <%- include('../partials/footer') %>
</body>
</html>
