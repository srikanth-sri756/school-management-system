<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/admin-head', { title: 'Attendance' }) %>
</head>
<body class="app">
  <%- include('../partials/navbar', { page: 'attendance' }) %>

  <%
    const count = (status) => todayAttendance.filter(a => a.status === status).length;
  %>
  <main class="container" id="main">
    <div class="page-header">
      <div>
        <h2>Student Attendance</h2>
        <p>Today’s summary · <%= selectedDate %></p>
      </div>
      <div class="page-actions">
        <a href="/attendance/report" class="btn"><%- icon('chart-column') %>View Report</a>
        <a href="/attendance/mark" class="btn btn-primary"><%- icon('calendar-check') %>Mark Attendance</a>
      </div>
    </div>

    <div class="stats-grid">
      <div class="stat-card">
        <span class="stat-icon"><%- icon('list-checks') %></span>
        <div class="stat-body"><p class="stat-label">Marked Today</p><div class="stat-value"><%= todayAttendance.length %></div></div>
      </div>
      <div class="stat-card">
        <span class="stat-icon stat-icon--green"><%- icon('user-check') %></span>
        <div class="stat-body"><p class="stat-label">Present</p><div class="stat-value"><%= count('Present') %></div></div>
      </div>
      <div class="stat-card">
        <span class="stat-icon stat-icon--amber"><%- icon('clock') %></span>
        <div class="stat-body"><p class="stat-label">Late</p><div class="stat-value"><%= count('Late') %></div></div>
      </div>
      <div class="stat-card">
        <span class="stat-icon stat-icon--red"><%- icon('user-x') %></span>
        <div class="stat-body"><p class="stat-label">Absent</p><div class="stat-value"><%= count('Absent') %></div></div>
      </div>
    </div>

    <section class="card card--flush">
      <div class="card-header"><h3><%- icon('calendar-check') %>Today’s Records</h3></div>
      <% if (todayAttendance.length) { %>
        <div class="table-container">
          <table>
            <thead>
              <tr><th>Student</th><th>Class</th><th>Roll No.</th><th>Status</th><th>Time</th><th class="num">Actions</th></tr>
            </thead>
            <tbody>
              <% todayAttendance.forEach(record => { const s = record.student; %>
                <tr>
                  <td>
                    <div class="cell-person">
                      <%- avatar('student', s) %>
                      <span class="cell-strong"><%= s ? s.firstName + ' ' + s.lastName : 'Unknown student' %></span>
                    </div>
                  </td>
                  <td><%= s && s.class ? s.class.name : '—' %></td>
                  <td><%= s ? s.rollNumber : '—' %></td>
                  <td><%- statusBadge(record.status) %></td>
                  <td><%= new Date(record.date).toLocaleTimeString('en-IN', { hour: '2-digit', minute: '2-digit' }) %></td>
                  <td class="num"><a href="/attendance/edit/<%= record._id %>" class="btn btn-sm"><%- icon('pencil') %>Edit</a></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <span class="stat-icon"><%- icon('calendar-check') %></span>
          <strong>No attendance marked today</strong>
          <p>Choose a class and mark who is present.</p>
          <a href="/attendance/mark" class="btn btn-primary"><%- icon('calendar-check') %>Mark Attendance</a>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
