<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/admin-head', { title: 'Edit Attendance' }) %>
</head>
<body class="app">
  <%- include('../partials/navbar', { page: 'attendance' }) %>

  <% const s = attendance.student || { firstName: 'Deleted', lastName: 'student' }; %>
  <main class="container container--narrow" id="main">
    <div class="page-header">
      <div>
        <a href="/attendance" class="back-link"><%- icon('arrow-left') %>Attendance</a>
        <h2>Edit Attendance</h2>
      </div>
    </div>

    <form method="POST" action="/attendance/edit/<%= attendance._id %>" class="card">
      <div class="profile-head">
        <%- avatar('student', s) %>
        <div>
          <h3><%= s.firstName %> <%= s.lastName %></h3>
          <div class="meta">
            <span><%= s.class ? s.class.name : 'No class' %></span><span>·</span><span>Roll <%= s.rollNumber || '—' %></span>
          </div>
        </div>
      </div>

      <div class="form-row">
        <div class="form-group">
          <label for="date">Date <span class="req">*</span></label>
          <input type="date" id="date" name="date" class="form-control" value="<%= /^\d{4}-\d{2}-\d{2}$/.test(attendance.date) ? attendance.date : isoDate(attendance.date) %>" required>
        </div>
        <div class="form-group">
          <label for="status">Status <span class="req">*</span></label>
          <select id="status" name="status" class="form-control" required>
            <% ['Present', 'Absent', 'Late'].forEach(st => { %>
              <option value="<%= st %>" <%= attendance.status === st ? 'selected' : '' %>><%= st %></option>
            <% }) %>
          </select>
        </div>
      </div>

      <div class="form-group">
        <label for="notes">Notes</label>
        <textarea id="notes" name="notes" class="form-control" rows="3" placeholder="Optional"><%= attendance.remarks || '' %></textarea>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%- icon('check') %>Save Changes</button>
        <a href="/attendance" class="btn">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
