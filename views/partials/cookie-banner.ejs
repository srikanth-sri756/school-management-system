<%# Cookie notice for the public website. Shown by public/js/site.js until the visitor
    chooses; the choice is kept for 6 months in the "cookie_consent" cookie.
    "all" also allows Google Maps (the only third-party cookies on the site). %>
<div class="cookie-banner" id="cookieBanner" role="region" aria-label="Cookie notice" hidden>
  <div class="cookie-banner-text">
    <strong>Cookies</strong>
    <p>We only use cookies that keep students and staff signed in and remember this choice. The map on our Contact page comes from Google and may set Google’s own cookies, so it loads only if you allow it. <a href="/portfolio/cookie-policy">Cookie policy</a></p>
  </div>
  <div class="cookie-banner-actions">
    <button type="button" class="pill pill--outline pill--sm" data-cookie-choice="essential">Essential only</button>
    <button type="button" class="pill pill--light pill--sm" data-cookie-choice="all">Allow Google Maps</button>
  </div>
</div>
