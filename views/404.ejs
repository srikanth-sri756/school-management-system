<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('partials/public-head', { title: 'Page Not Found' }) %>
</head>
<body class="site">
  <main class="not-found" id="main">
    <div class="container center">
      <div class="code" aria-hidden="true">404</div>
      <span class="label">Page not found</span>
      <h1 class="display display-m">We couldn’t find that page</h1>
      <p class="lede">The link may be broken, or the page may have moved.</p>
      <div class="pills pills--center">
        <% if (typeof user !== 'undefined' && user) { %>
          <a href="<%= user.role === 'teacher' ? '/teacher/dashboard' : '/dashboard' %>" class="pill pill--light">Back to dashboard</a>
          <a href="/" class="pill pill--dark">School website</a>
        <% } else { %>
          <a href="/" class="pill pill--light">Go to homepage</a>
          <a href="/portfolio/contact" class="pill pill--dark">Contact us</a>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>
