<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/admin-head', { title: 'Question Papers' }) %>
</head>
<body class="app">
  <%- include('../partials/navbar', { page }) %>

  <%
    const ready = teacher.class && teacher.subject;
    const typeTone = { Quiz: 'violet', Test: 'info', 'Mid-Term': 'warning', Final: 'danger', Assignment: 'success', Practice: 'navy' };
    const pad = (n) => String(n).padStart(2, '0');
    const now = new Date();
    const todayValue = `${now.getFullYear()}-${pad(now.getMonth() + 1)}-${pad(now.getDate())}`;
  %>
  <main class="container" id="main">
    <div class="page-header">
      <div>
        <h2>Question Papers</h2>
        <p><%= ready ? `Upload papers for ${classLabel(teacher.class)} · ${teacher.subject.name}. Your class can download them in the Student Portal.` : 'Upload question papers for your class.' %></p>
      </div>
    </div>

    <% if (!ready) { %>
      <div class="alert alert-info"><%- icon('info') %><div>You need an assigned class and subject before you can upload papers. Please ask the school office.</div></div>
    <% } else { %>
      <form method="POST" action="/teacher/test-papers/add" enctype="multipart/form-data" class="card">
        <div class="card-header"><h3><%- icon('upload') %>Upload a paper</h3></div>
        <div class="form-group">
          <label for="title">Title <span class="req">*</span></label>
          <input type="text" id="title" name="title" class="form-control" maxlength="150" required placeholder="e.g. Unit Test 2 – Algebra">
        </div>
        <div class="form-row form-row--3">
          <div class="form-group">
            <label for="examType">Type <span class="req">*</span></label>
            <select id="examType" name="examType" class="form-control" required>
              <% paperTypes.forEach(t => { %><option value="<%= t %>" <%= t === 'Test' ? 'selected' : '' %>><%= t %></option><% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="date">Date <span class="req">*</span></label>
            <input type="date" id="date" name="date" class="form-control" value="<%= todayValue %>" required>
          </div>
          <div class="form-group">
            <label for="maxMarks">Maximum marks <span class="req">*</span></label>
            <input type="number" id="maxMarks" name="maxMarks" class="form-control" min="1" value="100" required>
          </div>
        </div>
        <div class="form-group">
          <label for="description">Instructions</label>
          <textarea id="description" name="description" class="form-control" rows="3" maxlength="1000" placeholder="Optional: topics covered, time allowed, instructions…"></textarea>
        </div>
        <div class="form-group">
          <label for="questionPaper">Question paper file <span class="req">*</span></label>
          <input type="file" id="questionPaper" name="questionPaper" class="form-control" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png" required>
          <span class="form-hint">PDF, Word or image file, up to 10 MB.</span>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary"><%- icon('upload') %>Upload paper</button>
        </div>
      </form>
    <% } %>

    <section class="card card--flush">
      <div class="card-header">
        <h3><%- icon('file-text') %>My question papers</h3>
        <span class="result-count"><%= testPapers.length %> <%= testPapers.length === 1 ? 'paper' : 'papers' %></span>
      </div>
      <% if (testPapers.length) { %>
        <div class="table-container">
          <table>
            <thead><tr><th>Paper</th><th>Type</th><th>Class</th><th>Date</th><th class="num">Max</th><th class="num">Downloads</th><th class="num">Actions</th></tr></thead>
            <tbody>
              <% testPapers.forEach(p => { %>
                <tr>
                  <td>
                    <span class="cell-strong"><%= p.title %></span>
                    <span class="cell-sub"><%= p.subject ? p.subject.name : '' %><%= p.description ? ' · ' + (p.description.length > 70 ? p.description.slice(0, 70) + '…' : p.description) : '' %></span>
                  </td>
                  <td><span class="badge badge-<%= typeTone[p.examType] || 'navy' %>"><%= p.examType || 'Test' %></span></td>
                  <td><%= p.class ? classLabel(p.class) : '—' %></td>
                  <td><%= new Date(p.date).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %></td>
                  <td class="num"><%= p.maxMarks %></td>
                  <td class="num"><%= p.downloads || 0 %></td>
                  <td class="num">
                    <div class="actions actions--end">
                      <% if (p.file && p.file.filename) { %>
                        <a href="/teacher/test-papers/<%= p._id %>/download" class="btn btn-sm btn-ghost" title="Download <%= p.file.originalName %>" aria-label="Download paper"><%- icon('download') %></a>
                      <% } %>
                      <form method="POST" action="/teacher/test-papers/<%= p._id %>/delete" data-confirm="Delete “<%= p.title %>”? Students will no longer be able to download it.">
                        <button type="submit" class="btn btn-sm btn-danger" title="Delete" aria-label="Delete paper"><%- icon('trash-2') %></button>
                      </form>
                    </div>
                  </td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      <% } else { %>
        <div class="empty-state">
          <span class="stat-icon"><%- icon('file-text') %></span>
          <strong>No papers yet</strong>
          <p>Papers you upload will be listed here.</p>
        </div>
      <% } %>
    </section>
  </main>
</body>
</html>
