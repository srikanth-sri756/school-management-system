<!DOCTYPE html>
<html lang="en">
<head>
  <%- include('../partials/admin-head', { title: 'Edit Fee' }) %>
</head>
<body class="app">
  <%- include('../partials/navbar', { page: 'fees' }) %>

  <% const terms = ['Term 1', 'Term 2', 'Term 3', 'Annual', 'Admission', 'Development', 'Transport', 'Other']; %>
  <main class="container container--narrow" id="main">
    <div class="page-header">
      <div>
        <a href="/fees" class="back-link"><%- icon('arrow-left') %>Fees</a>
        <h2>Edit Fee</h2>
        <% if (fee.hasInstallmentPlan) { %><p>This fee has an instalment plan. Record instalment payments from the instalments page.</p><% } %>
      </div>
      <% if (fee.hasInstallmentPlan) { %>
        <div class="page-actions"><a href="/fees/<%= fee._id %>/installments" class="btn"><%- icon('list-checks') %>View Instalments</a></div>
      <% } %>
    </div>

    <form method="POST" action="/fees/<%= fee._id %>/edit" class="card">
      <div class="form-section">
        <h3 class="form-section-title"><%- icon('receipt') %>Fee details</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="student">Student <span class="req">*</span></label>
            <select name="student" id="student" class="form-control" required>
              <% students.forEach(s => { %>
                <option value="<%= s._id %>" <%= fee.student && fee.student._id.toString() === s._id.toString() ? 'selected' : '' %>><%= s.firstName %> <%= s.lastName %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="term">Term <span class="req">*</span></label>
            <select name="term" id="term" class="form-control" required>
              <% if (fee.term && !terms.includes(fee.term)) { %><option value="<%= fee.term %>" selected><%= fee.term %></option><% } %>
              <% terms.forEach(t => { %><option value="<%= t %>" <%= fee.term === t ? 'selected' : '' %>><%= t %></option><% }) %>
            </select>
          </div>
        </div>
        <div class="form-group">
          <label for="notes">Notes</label>
          <textarea name="notes" id="notes" class="form-control" rows="2" placeholder="Optional"><%= fee.notes || '' %></textarea>
        </div>
      </div>

      <div class="form-section">
        <h3 class="form-section-title"><%- icon('wallet') %>Payment</h3>
        <div class="form-row">
          <div class="form-group">
            <label for="amount">Total amount (₹) <span class="req">*</span></label>
            <input type="number" name="amount" id="amount" class="form-control" value="<%= fee.amount %>" min="0" step="0.01" required>
          </div>
          <div class="form-group">
            <label for="paid">Amount paid (₹)</label>
            <input type="number" name="paid" id="paid" class="form-control" value="<%= fee.paid || 0 %>" min="0" step="0.01">
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label for="status">Status</label>
            <select name="status" id="status" class="form-control">
              <% ['Paid', 'Partial', 'Unpaid'].forEach(st => { %>
                <option value="<%= st %>" <%= fee.status === st ? 'selected' : '' %>><%= st %></option>
              <% }) %>
            </select>
          </div>
          <div class="form-group">
            <label for="dueDate">Due date</label>
            <input type="date" name="dueDate" id="dueDate" class="form-control" value="<%= isoDate(fee.dueDate) %>">
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary"><%- icon('check') %>Save Changes</button>
        <a href="/fees" class="btn">Cancel</a>
      </div>
    </form>
  </main>
</body>
</html>
