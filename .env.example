# Server
PORT=3000
NODE_ENV=development

# MongoDB connection (the app stores all its data here).
# Local MongoDB, or a MongoDB Atlas connection string in production.
MONGODB_URI=mongodb://127.0.0.1:27017/school_management

# Secret used to sign login sessions. Use a long random value in production.
SESSION_SECRET=change_me_to_a_long_random_string

# Used only by the /admin/setup page, which creates this administrator if it
# doesn't exist yet. (npm run init-db always creates admin@school.com / admin123.)
ADMIN_EMAIL=admin@school.com
ADMIN_PASSWORD=admin123
